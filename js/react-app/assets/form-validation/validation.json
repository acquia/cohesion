    },
    "cssTransformAngle": {
        "regx": "^([-+]?\\d*(\\.*\\d+))(deg|grad|rad|turn)?$|(calc\\(.*?\\))$",
        "message": "Invalid CSS value"
    },
    "cubicBezier": {
        "regx": "^(-?[0-9]\\d*(\\.\\d+)?,){3}-?[0-9]\\d*(\\.\\d+)?$",
        "message": "Must be 4 comma separated numbers"
    },
    "idOrClass": {
        "regx": "^[.#][^\\s]+$",
        "message": "Invalid ID or class"
    },
    "numberWithInfinite": {
        "regx": "^(([+]?([0-9]+(?:[\\.][0-9]*)?|\\.[0-9]+))|(infinite))$",
        "message": "Invalid number"
    },
    "safeNumber": {
        "regx": "^[-+]?[0-9]\\d*(\\.\\d+)?$",
        "message": "Invalid number"
    },
    "lengthWithUnit": {
        "regx": "^(-?\\d*(\\.?\\d+)(em|ex|px|%|cm|mm|in|pt|pc|ch|rem|vh|vw|vmin|vmax)?)$",
        "message": "Invalid css length"
    },
    "safeText": {
        "regx": "^[0-9a-zA-Z\\-_]*$",
