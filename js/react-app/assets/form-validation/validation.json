    },
    "safeFontStack": {
        "regx": "^[0-9a-zA-Z'\",\\s\\-_]*$",
        "message": "Invalid text"
    },
    "scssVariableName":{
        "regx": "^(?=[a-zA-Z]{1})(?!([\\$]?)coh-)[0-9a-zA-Z\\-_]*$",
        "message": "Must start with a letter"
    },
    "scssVariableNameExcludeCohPrefix": {
        "regx": "^(?!([\\$]?)coh-)[a-zA-Z0-9-_]*$",
        "message": "Invalid variable"
    },
    "url": {
        "regx": "^(http:|https:)?\\/\\/.+(\\.[a-z]+)",
        "message": "Invalid url"
    },
    "breakpointWidth": {
        "function": true,
        "message": "Breakpoint widths should not intersect."
    },
