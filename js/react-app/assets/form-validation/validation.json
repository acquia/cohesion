    "scssVariable": {
        "regx": "^[\\$][A-Za-z0-9-]+$",
        "message": "Invalid variable"
    },
    "cssOpacity": {
        "regx": "^(0(\\.\\d+)?|1(\\.0+)?)$",
        "message": "Invalid opacity",
