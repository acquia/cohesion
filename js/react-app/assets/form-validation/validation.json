    },
    "html5Video": {
        "regx": "^(http:|https:)?\\/\\/.+(\\.(mp4|ogv|ogg|webm|mkv)+)",
        "message": "Invalid HTML5 video url"
    },
    "scssValue": {
        "regx": "^[^$;:^$]+$",
        "message": "Invalid value"
    },
    "youTubeUrl": {
        "regx": "^.*(?:(?:youtu\\.be\\/|v\\/|vi\\/|u\\/\\w\\/|embed\\/)|(?:(?:watch)?\\?v(?:i)?=|\\&v(?:i)?=))([^#\\&\\?]*).*",
        "message": "Invalid link"
    },
    "idOrClassOrBase": {
        "regx": "^(.|#)\\w+|\\w+$",
