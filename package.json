{
  "name": "site-studio",
  "version": "1.0.0",
  "description": "Site Studio",
  "main": "",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "install:dev": "npm install",
    "install:prod": "npm ci --omit=dev",
    "coverage:clean": "rm -rf .nyc_output && rm -rf coverage",
    "report:dx8-gateway": "nyc mocha --reporter mocha-sonarqube-reporter --recursive ./cohesion-services/dx8-gateway/node/app/test/**/*.test.js --reporter-options output=./coverage/dx8-gateway/test-report.xml --extension .js --exit",
    "coverage:dx8-gateway": "nyc report --reporter=lcov --reporter=text --report-dir=./coverage/dx8-gateway",
    "compile": "gulp",
    "compile:scss": "gulp compileScss",
    "watch:scss": "gulp watchScss",
    "lint:scss": "gulp lintScss",
    "lint:scss:fix": "gulp lintAndFixScss",
    "lint:css": "gulp lintCss",
    "lint:css:fix": "gulp lintAndFixCss"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acquia/cohesion-dev.git"
  },
  "author": "Acquia Engineering <cohesion-devs@acquia.com>",
  "bugs": {
    "url": "https://github.com/acquia/cohesion-dev/issues"
  },
  "homepage": "https://github.com/acquia/cohesion-dev#readme",
  "overrides": {
    "ejs": "^3.1.10",
    "debug": "^4.3.4",
    "minimatch": "9.0.9",
    "flat": "^6.0.1",
    "js-yaml": "^4.1.0",
    "form-data": "^4.0.0",
    "tough-cookie": "^5.0.0",
    "flatted": "^3.4.2",
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  },
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^3.0.1",
    "gulp": "^5.0.0",
    "gulp-postcss": "^10.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-stylelint-esm": "^2.2.0",
    "mocha": "^11.0.0",
    "mocha-sonarqube-reporter": "^1.0.2",
    "nyc": "^18.0.0",
    "postcss": "^8.4.41",
    "sass": "^1.102.0",
    "stylelint": "^16.8.2",
    "stylelint-config-recommended": "^14.0.1",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-scss": "^6.5.0"
  }
}
